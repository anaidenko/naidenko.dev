# Build-time settings for Next.js. Copy to .env.production.local for a deploy build
# (ignored by git). Values set in the shell win over the files.

# Cloudflare Turnstile site key (public). Without it, `pnpm run deploy` refuses to run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to ship no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
