# Copy to .dev.vars for `wrangler dev`. Cloudflare's public Turnstile test secret and a dummy
# inbox: locally the email is only logged. Production values are Wrangler secrets (README).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_TO=inbox@example.net
# Optional locally: a Slack incoming webhook for form alerts. Empty means alerts are only logged.
SLACK_WEBHOOK_URL=
# The password for /stats. A local test value; production uses the Wrangler secret.
STATS_PASSWORD=test-password
# The key of the visitor hash. A local test value; production uses a random Wrangler secret.
VISITOR_KEY=local-test-key
# Networks whose visits are not counted: CIDR ranges or addresses, comma-separated. The e2e tests
# use this documentation range; production lists the owner's own network.
IGNORE_NETWORKS=203.0.113.0/24
