{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "naidenko-dev",
    "main": "worker/index.ts",
    "compatibility_date": "2026-09-24",
    // `wrangler deploy` attaches the domain and Cloudflare issues its certificate. toptal.naidenko.dev
    // belongs to the Toptal build's Worker (wrangler.toptal.jsonc).
    "routes": [{ "pattern": "naidenko.dev", "custom_domain": true }],
    "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // Every path without a dot runs the Worker: the API, the stats page, and each HTML page, so LinkedIn's
        // crawler gets the link's ?ref= on any of them ("/" also serves Markdown to agents). A file with an
        // extension stays a free static-asset request; a negative pattern wins over "/*".
        "run_worker_first": ["/*", "!/*.*"]
    },
    "send_email": [{ "name": "EMAIL" }],
    // Three messages a minute per visitor address, so nobody can flood the inbox.
    "ratelimits": [
        { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
        // Page views and clicks: generous for a person, a ceiling for a script.
        { "name": "HIT_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
    ],
    // The visit counter: one row per visit and per click or section reached (worker/migrations).
    "d1_databases": [
        {
            "binding": "STATS_DB",
            "database_name": "naidenko-stats",
            "database_id": "f84a6868-a9df-47ff-a820-464c0a43de0c",
            "migrations_dir": "worker/migrations"
        }
    ],
    // GOATCOUNTER_DASHBOARD: linked from /stats to compare the two counters. TOPTAL_ORIGIN: where a
    // page tagged ?ref=toptal… moves (worker/toptal.ts); empty turns the move off.
    "vars": {
        "CONTACT_FROM": "form@naidenko.dev",
        "GOATCOUNTER_DASHBOARD": "https://naidenko.goatcounter.com/",
        "TOPTAL_ORIGIN": "https://toptal.naidenko.dev"
    },
    // Daily, at a quiet hour: erases visitor hashes older than 13 months (worker/retention.ts).
    "triggers": { "crons": ["17 3 * * *"] },
    "observability": { "enabled": true }
}
