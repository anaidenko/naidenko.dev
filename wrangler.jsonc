{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "naidenko-dev",
    "main": "worker/index.ts",
    "compatibility_date": "2026-09-24",
    // `wrangler deploy` attaches the domain and Cloudflare issues its certificate.
    "routes": [{ "pattern": "naidenko.dev", "custom_domain": true }],
    "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // Only the API runs the Worker; every other request is a free static-asset request.
        "run_worker_first": ["/api/*"]
    },
    "send_email": [{ "name": "EMAIL" }],
    // Three messages a minute per visitor address, so nobody can flood the inbox.
    "ratelimits": [{ "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
    "vars": { "CONTACT_FROM": "form@naidenko.dev" },
    "observability": { "enabled": true }
}
